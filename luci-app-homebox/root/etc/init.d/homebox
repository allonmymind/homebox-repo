#!/bin/sh /etc/rc.common
# Homebox init script (procd)
START=95
STOP=15
USE_PROCD=1

start_service() {
	# 读取启用状态：优先匿名段 homebox.@homebox[0]，兼容命名段 homebox.main
	enabled=$(uci -q get homebox.@homebox[0].enabled)
	[ -z "$enabled" ] && enabled=$(uci -q get homebox.main.enabled)
	enabled="${enabled:-0}"
	[ "$enabled" = "1" ] || return 0

	port=$(uci -q get homebox.@homebox[0].port)
	[ -z "$port" ] && port=$(uci -q get homebox.main.port)
	port="${port:-3300}"

	procd_open_instance
	procd_set_param command /usr/bin/homebox serve --port "$port"
	procd_set_param stdout 1
	procd_set_param stderr 1
	procd_close_instance
}

stop_service() {
	killall homebox 2>/dev/null || true
}

# 关键：homebox 配置变化时，procd 自动 restart 本服务；
# restart 会按上面 enabled 守卫决定启动或停止，从而实现网页勾选即时生效。
service_triggers() {
	procd_add_config_trigger "config.change" "homebox" "/etc/init.d/homebox" "restart"
}
